{{- define "content" -}}
{{- $is_blog_post := .Page.Params.blog_post | default false -}}
{{- $has_toc := and (ne .TableOfContents "<nav id=\"TableOfContents\"></nav>") (.Scratch.Get "params").enable_toc -}}

{{ if $is_blog_post }}

<h1>{{ .Title }}</h1>

<div class="blog-post-meta">
    {{ if .Params.date }}
    <span class="date">{{ .Params.date | time.Format ":date_long" }}</span>
    {{ end }}

    {{ if .Params.categories }}
    <span> • </span>
    {{ partial "categories.html" .Page }}
    {{ end }}
</div>
{{ end }}

{{- /* Mobile: collapsible ToC, shown below xl breakpoint */ -}}
{{ if $has_toc }}
<details class="toc-mobile">
    <summary class="toc-mobile-summary"><span>Table of Contents</span></summary>
    <div class="toc-mobile-body">
        {{ .TableOfContents | replaceRE `id="TableOfContents"` `id="TableOfContentsMobile"` | safeHTML }}
    </div>
</details>
{{ end }}

{{- /* Two-column flex wrapper: article on left, sticky sidebar on right */ -}}
<div class="post-layout">
    <div class="post-body">
        <div class="blog-body">

            {{ if $is_blog_post }}
                <h2 class="blog-introduction-header" id="introduction">Introduction</h2>
            {{ end }}

            {{ if .Content }}
            <div class="content-margin">
                {{- partial "content.html" (dict "ctx" . "content" .Content) -}}
            </div>
            {{ end }}

        </div>
    </div>

    {{- /* Desktop: sticky sidebar ToC, shown at xl+ */ -}}
    {{ if $has_toc }}
    <aside class="toc-sidebar">
        <div class="toc-sidebar-title">Contents</div>
        {{ .TableOfContents }}
    </aside>
    {{ end }}
</div>

{{ if $is_blog_post }}
    {{ partial "blog-post-footer.html" . }}
{{ end }}

{{- end -}}
